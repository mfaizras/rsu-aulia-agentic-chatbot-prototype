# Salin file ini menjadi .env, lalu ganti semua nilai rahasia.
POSTGRES_DB=rsu_aulia
POSTGRES_USER=rsu_aulia
POSTGRES_PASSWORD=ganti-dengan-password-database-yang-kuat
SECRET_KEY=ganti-dengan-random-secret-yang-kuat

# Domain tanpa http:// atau https://. Arahkan DNS A/AAAA domain ke server ini.
DOMAIN=contoh.domain.com
WEB_WORKERS=2

# Port untuk akses lokal web service (localhost:5000). Tidak perlu diubah jika hanya dipakai lokal.
WEB_PORT=5000

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7

TELEGRAM_BOT_TOKEN=
TELEGRAM_MESSAGE_DEBOUNCE_SECONDS=1
TELEGRAM_CONCURRENT_UPDATES=16
ADMINISTRATIVE_API_TIMEOUT=15
PII_MASKING_ENABLED=true

HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
